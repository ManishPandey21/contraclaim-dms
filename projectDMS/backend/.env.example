# Backend environment example for ContraClaim DMS

# Runtime mode
ENVIRONMENT=production
ENABLE_API_DOCS=false
ALLOW_DEV_HEADERS=false

# MongoDB connection string
DATABASE_URL=mongodb://app_user:replace-with-password@mongo1.example.internal:27017,mongo2.example.internal:27017,mongo3.example.internal:27017/contraclaim?replicaSet=rs0&authSource=admin&retryWrites=true
MONGODB_DATABASE=contraclaim
MONGODB_APP_NAME=ContractDMS
MONGODB_MAX_POOL_SIZE=100
MONGODB_MIN_POOL_SIZE=0
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=20000
MONGODB_REPLICA_SET=rs0
MONGODB_RETRY_WRITES=true
MONGODB_ALLOW_STANDALONE_PRODUCTION=false

# Runtime state Redis for sessions, rate limits, and shared cache
APP_REDIS_URL=redis://:change-me@redis:6379/1
RUNTIME_STATE_REDIS_URL=redis://:change-me@redis:6379/1

# Worker startup controls
START_BACKGROUND_SERVICES=true
START_CONTRACT_QUEUE_WORKERS=true
CONTRACT_QUEUE_REDIS_URL=redis://:change-me@redis:6379/0

# Secret key for JWT/session crypto
SECRET_KEY=replace-with-a-secure-random-string

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=https://app.example.com

# Uploads base directory (absolute or relative to backend working dir)
UPLOADS_DIR=/app/uploads
SECURE_UPLOADS_DIR=/app/uploads
UPLOAD_STREAM_CHUNK_SIZE_MB=1
UPLOAD_VALIDATION_SAMPLE_BYTES=8192
GENERAL_UPLOAD_MAX_FILE_SIZE_MB=100
UPLOAD_MAX_CONCURRENT_PER_USER=3
UPLOAD_MAX_CONCURRENT_PER_ORG=20

# Observability
METRICS_ENABLED=true
METRICS_TOKEN=replace-with-internal-scrape-token
SLOW_REQUEST_THRESHOLD_MS=2000

# OpenAI keys (required for semantic search + summaries)
OPENAI_API_KEY=replace-with-openai-api-key
# Optional: override Responses API model used for summaries
OPENAI_RESPONSES_MODEL=gpt-4.1

# AWS S3 configuration (used by folder_structure router)
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=your-bucket-name

# Token settings (if applicable)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional logging level
LOG_LEVEL=INFO

# SMTP configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-username
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-app-password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME="ContraClaim DMS"
SMTP_ENCRYPTION=starttls
SMTP_SETTINGS_ENCRYPTION_KEY=replace-with-fernet-key-or-32-byte-secret
CONTACT_RECIPIENT_EMAIL=pandey.manishkumar@gmail.com
EMAIL_FROM=noreply@contraclaim.com
APP_URL=https://app.example.com
PUBLIC_API_URL=https://app.example.com/api
DOCUMENT_SHARE_TOKEN_TTL_DAYS=30
SHARE_EMAIL_ATTACHMENT_MAX_MB=15
