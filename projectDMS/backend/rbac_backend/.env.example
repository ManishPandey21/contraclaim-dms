# Backend configuration
ENVIRONMENT="development"
DATABASE_URL="mongodb://localhost:27017/contraclaim"
MONGODB_DATABASE="contraclaim"
MONGODB_APP_NAME="ContractDMS"
MONGODB_MAX_POOL_SIZE="100"
MONGODB_MIN_POOL_SIZE="0"
MONGODB_SERVER_SELECTION_TIMEOUT_MS="5000"
MONGODB_CONNECT_TIMEOUT_MS="5000"
MONGODB_SOCKET_TIMEOUT_MS="20000"
MONGODB_REPLICA_SET=""
MONGODB_RETRY_WRITES="true"
MONGODB_ALLOW_STANDALONE_PRODUCTION="false"
SECRET_KEY="replace-with-secure-random-secret"
ALLOW_DEV_HEADERS="false"
RBAC_ENTITLEMENT_FAIL_OPEN="false"
AUTH_COOKIE_NAME="cc_access_token"
AUTH_COOKIE_SECURE="false"
AUTH_COOKIE_SAMESITE="lax"
AUTH_COOKIE_DOMAIN=""
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="30"
LOGIN_IP_RATE_LIMIT_REQUESTS="60"
LOGIN_IP_RATE_LIMIT_WINDOW="900"
LOGIN_EMAIL_RATE_LIMIT_REQUESTS="30"
LOGIN_EMAIL_RATE_LIMIT_WINDOW="3600"
CORS_ORIGINS="[\"https://web.contraclaim.com\", \"https://app.contraclaim.com\", \"https://www.contraclaim.com\", \"http://localhost:5173\", \"http://127.0.0.1:5173\", \"https://localhost:5173\", \"https://127.0.0.1:5173\"]"

# AWS configuration
AWS_ACCESS_KEY_ID="replace-with-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="replace-with-aws-secret-access-key"
AWS_REGION="ap-south-1"
AWS_BUCKET_NAME="replace-with-bucket-name"

# Upload directories
UPLOADS_DIR="uploads"
SECURE_UPLOADS_DIR="backend/uploads"

# Graph / orchestration integration
LANGGRAPH_ENABLED="false"
LANGGRAPH_API_TOKEN="replace-with-internal-service-token"
GRAPH_PROVIDER="direct_falkor"
FALKORDB_ENABLED="true"
FALKORDB_HOST="localhost"
FALKORDB_PORT="6380"
FALKORDB_URL="redis://localhost:6380"
FALKORDB_GRAPH_NAME="contraclaim"
FALKORDB_PASSWORD=""
GRAPHITI_ENABLED="false"
GRAPHITI_API_URL=""
GRAPHITI_BASE_URL=""
GRAPHITI_API_KEY=""
GRAPHITI_WORKSPACE="ContraClaim"

# Inngest integration
INNGEST_APP_ID="contractdms"
INNGEST_EVENT_KEY=""
INNGEST_API_URL="https://api.inngest.com"

# Antivirus configuration
ANTIVIRUS_ENABLED="false"
CLAMAV_HOST="clamav"
CLAMAV_PORT="3310"
CLAMAV_TIMEOUT="30"
CLAMAV_FAIL_OPEN="false"

# Allowed MIME types
# Archives are stored intact, never unpacked. RAR stays off until the
# deployed clamd is shown to detect EICAR inside a .rar.
RAR_UPLOAD_ENABLED=false
ALLOWED_DOCUMENT_MIMES="[\"application/pdf\", \"image/png\", \"image/jpeg\", \"text/plain\", \"application/zip\"]"
ALLOWED_ENCLOSURE_MIMES="[\"application/pdf\", \"image/png\", \"image/jpeg\", \"text/plain\", \"application/zip\"]"

# OpenAI configuration
OPENAI_API_KEY="replace-with-openai-api-key"
ASSISTANT_ID="replace-with-assistant-id"
ASSISTANT_ID1="replace-with-assistant-id"

# PydanticAI configuration
PYDANTIC_AI_ENABLED="false"
PYDANTIC_AI_MODEL="gpt-4o-mini"
PYDANTIC_AI_PROVIDER="openai"
PYDANTIC_AI_BASE_URL=""
PYDANTIC_AI_TEMPERATURE="0.1"
PYDANTIC_AI_MAX_RETRIES="2"

# SMTP configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USERNAME="replace-with-smtp-username"
SMTP_PASSWORD="replace-with-smtp-app-password"
SMTP_FROM_EMAIL="noreply@example.com"
SMTP_FROM_NAME="ContraClaim DMS"
SMTP_ENCRYPTION="starttls"
SMTP_SETTINGS_ENCRYPTION_KEY=""
CONTACT_RECIPIENT_EMAIL="support@example.com"
APP_URL="http://localhost:5173"
PUBLIC_API_URL="http://localhost:8000/api"
DOCUMENT_SHARE_TOKEN_TTL_DAYS=30
SHARE_EMAIL_ATTACHMENT_MAX_MB=15

# Observability
METRICS_ENABLED="true"
METRICS_TOKEN=""
SLOW_REQUEST_THRESHOLD_MS="7000"
BACKUP_ROOT="/var/backups/contractdms"
BACKUP_MAX_AGE_HOURS="26"
BACKUP_REQUIRED_IN_PRODUCTION="false"
BACKUP_REQUIRED_VOLUME_LABELS="backend-uploads,qdrant-data,falkordb-data,redis-data"
BACKUP_S3_BUCKET=""
BACKUP_S3_PREFIX="contraclaim/backups"

# --- Payment gateway (Razorpay) ---
# PAYMENT_PROVIDER=noop disables billing (default). Set to razorpay for live billing
# and fill the keys from the Razorpay dashboard. Webhook URL: /api/billing/webhooks/razorpay
PAYMENT_PROVIDER=noop
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- SSO (generic OpenID Connect) ---
# Set OIDC_ENABLED=true and fill issuer/client to enable /api/auth/sso/login.
# Works with Microsoft Entra ID, Google, Okta, Auth0, Keycloak, etc.
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_ALLOWED_EMAIL_DOMAINS=
OIDC_AUTO_PROVISION=true
OIDC_DEFAULT_ROLE=orguser
OIDC_DEFAULT_ORG_ID=

# --- Tracing (OpenTelemetry, opt-in) ---
# Install opentelemetry-* packages + set these to export traces to a collector.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=contraclaim-backend
OTEL_EXPORTER_OTLP_ENDPOINT=

# Unified extraction rollout. Global switch stays false; organisations are
# opted in one at a time via the canary allowlist (comma-separated org ids).
# The choice is recorded on each job at creation, so changing these never
# reclassifies work already queued.
UNIFIED_EXTRACTION_ENABLED=false
UNIFIED_EXTRACTION_CANARY_ORG_IDS=
# The LLM/Vision extraction fallback - the only runtime cost in the pipeline.
EXTRACTION_FALLBACK_ENABLED=false
EXTRACTION_FALLBACK_MAX_PAGES_PER_DOCUMENT=5
