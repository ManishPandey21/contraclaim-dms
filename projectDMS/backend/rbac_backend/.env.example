# Backend configuration
DATABASE_URL="mongodb://localhost:27017/contraclaim"
SECRET_KEY="replace-with-secure-random-secret"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="30"
CORS_ORIGINS="[\"https://web.contraclaim.com\", \"https://app.contraclaim.com\", \"https://www.contraclaim.com\", \"http://localhost:5173\", \"http://127.0.0.1:5173\", \"https://localhost:5173\", \"https://127.0.0.1:5173\"]"

# AWS configuration
AWS_ACCESS_KEY_ID="replace-with-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="replace-with-aws-secret-access-key"
AWS_REGION="ap-south-1"
AWS_BUCKET_NAME="contraclaim"

# Upload directories
UPLOADS_DIR="/var/www/app.contraclaim.com/backend/uploads"
SECURE_UPLOADS_DIR="backend/uploads"

# Graphiti integration
GRAPHITI_API_URL=""
GRAPHITI_API_KEY=""
GRAPHITI_WORKSPACE=""

# Inngest integration
INNGEST_APP_ID="contractdms"
INNGEST_EVENT_KEY=""
INNGEST_API_URL="https://api.inngest.com"

# LlamaIndex integration
LLAMA_INDEX_ENABLED="true"
LLAMA_INDEX_STORAGE_DIR="storage/llama_index"

# Allowed MIME types
ALLOWED_DOCUMENT_MIMES="[\"application/pdf\", \"image/png\", \"image/jpeg\", \"text/plain\"]"
ALLOWED_ENCLOSURE_MIMES="[\"application/pdf\", \"image/png\", \"image/jpeg\", \"text/plain\"]"

# OpenAI configuration
OPENAI_API_KEY="replace-with-openai-api-key"
ASSISTANT_ID="replace-with-assistant-id"
ASSISTANT_ID1="replace-with-assistant-id"

# PydanticAI configuration
PYDANTIC_AI_ENABLED="false"
PYDANTIC_AI_MODEL="gpt-4o-mini"
PYDANTIC_AI_PROVIDER="openai"
PYDANTIC_AI_BASE_URL=""
PYDANTIC_AI_TEMPERATURE="0.1"
PYDANTIC_AI_MAX_RETRIES="2"

# SMTP configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USERNAME="replace-with-smtp-username"
SMTP_PASSWORD="replace-with-smtp-app-password"
SMTP_FROM_EMAIL="noreply@example.com"
