# Frontend environment example for ContraClaim DMS (Vite)

# Base URL to your FastAPI backend (no trailing slash)
# In dev, the backend typically runs on http://127.0.0.1:8000
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Optional feature flags
# VITE_ENABLE_DEMO_HEADERS=false

# Vite dev server port (informational; configured in vite.config.ts)
# VITE_DEV_SERVER_PORT=5173
