# Global
COMPOSE_PROJECT_NAME=contract-ai
PUBLIC_BASE_URL=http://localhost

# Backend API
BACKEND_PORT=8000
BACKEND_WORKERS=4
MONGODB_URI=mongodb://mongo:27017/contractdms

# OpenAI / AI Providers
# OpenAI configuration
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-4o

# Qdrant
QDRANT_API_KEY=change-me
QDRANT_COLLECTION=contracts
QDRANT_VECTOR_SIZE=1536
QDRANT_DISTANCE=Cosine
QDRANT_TIMEOUT=15

# FalkorDB
FALKORDB_ENABLED=true
FALKORDB_HOST=localhost
FALKORDB_PORT=6380
FALKORDB_GRAPH_NAME=contraclaim
FALKORDB_CLEANUP_REFERENCES=true
FALKORDB_PASSWORD=change-me

# Redis
REDIS_PASSWORD=change-me

# Docling Service
DOCLING_ALLOWED_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.tiff,.bmp,.docx,.pptx
DOCLING_MAX_FILE_SIZE_MB=150
DOCLING_LOG_LEVEL=INFO

# Marker CLI (contract ingestion)
# Requires Marker CLI installed and available on PATH.
MARKER_ENABLED=true
MARKER_CMD=marker
MARKER_OUTPUT_DIR=uploads/marker

# Vector database integration
VECTORDB_URL=http://qdrant:6333
VECTORDB_API_KEY=
VECTORDB_COLLECTION=documents
VECTORDB_BATCH_SIZE=64
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# LangGraph / Orchestration
LANGGRAPH_API_TOKEN=change-me
LANGGRAPH_DEFAULT_AGENT=contract_drafter

# Logging & Monitoring
LOG_LEVEL=INFO
SENTRY_DSN=

# Optional SMTP / Notifications
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=replace-with-email-username
EMAIL_PASSWORD=replace-with-email-app-password
EMAIL_FROM=noreply@example.com

# SMTP configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-app-password
SMTP_FROM_EMAIL=noreply@example.com
