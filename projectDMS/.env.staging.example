# Staging environment template — copy to `.env.staging` on the staging host.
#
#   cp .env.staging.example .env.staging   # then fill every REPLACE- value
#
# NO VALUE IN THIS FILE IS REAL, AND NO REAL VALUE MAY EVER BE COMMITTED TO IT.
# `.env.staging` itself is gitignored alongside every other `.env*`.
#
# Two rules this file exists to enforce:
#
# 1. **Nothing here may be a production credential.** Not the OpenAI key, not
#    the AWS identity, not the buckets, not SMTP. A staging run that reaches a
#    production bucket is a production incident, and Gate 2 bullet 2 measured
#    with a production key certifies nothing about staging anyway.
# 2. **Nothing here may address the development machine.** Every endpoint is a
#    staging container or a staging host. The Gate-2 preflight
#    (`backend/rbac_backend/tests/staging_gate.py`) refuses localhost and
#    127.0.0.1 outright, so a forgotten override fails loudly instead of
#    measuring the wrong engine.
#
# The nineteen `:?` variables in `docker-compose.prod.yml` are start-required:
# compose will not render the configuration without them, so nothing — not a
# health check, not a migration, not a permission seed — can begin until each is
# set.

# --- Project identity ------------------------------------------------------ #
# The compose project name is pinned in docker-compose.staging.yml (`name:`),
# which is what namespaces every network and volume as `contraclaim-stg_*`.
# It is repeated here only so `docker compose -p` and the file agree.
COMPOSE_PROJECT_NAME=contraclaim-stg

# `ENVIRONMENT` is NOT set here. docker-compose.prod.yml pins it to `production`
# for every application container on purpose: the backend's fail-closed
# behaviour is keyed on that value, and a staging stack that relaxed it would
# certify a weaker application than the one that ships.

# --- MongoDB replica set --------------------------------------------------- #
# `rsstg`, not `rs0`: a mis-set DATABASE_URL then fails to connect instead of
# quietly reaching a production-shaped replica set.
MONGO_REPLICA_SET_NAME=rsstg
MONGODB_REPLICA_SET=rsstg
MONGODB_DATABASE=contraclaim_staging
# WiredTiger internal cache per member, in GB. Three members on a 24 GB host
# with 16 GB given to the container runtime: 1 GB each. Unset, each mongod sizes
# its cache at half the visible RAM minus 1 GB and all three see the whole host.
MONGO_WIREDTIGER_CACHE_GB=1
MONGO_MEMORY_LIMIT=2g
# Quoted, and it has to stay quoted. The value contains `&`; unquoted, any
# consumer that reads this file with the shell backgrounds the assignment and
# the variable silently never arrives. R-A8M measured exactly that: staging
# carried the unquoted form, production_backup.sh died on "MONGO_URI or
# DATABASE_URL is required", and no staging backup was taken (F-A8M-2).
DATABASE_URL="mongodb://stg_user:REPLACE-WITH-STAGING-PASSWORD@mongo1:27017,mongo2:27017,mongo3:27017/contraclaim_staging?replicaSet=rsstg&authSource=admin&retryWrites=true"
MONGODB_RETRY_WRITES=true

# --- Generated staging secrets --------------------------------------------- #
# Mint these on the staging host; none of them exists anywhere else.
#   openssl rand -hex 32
SECRET_KEY=REPLACE-WITH-64-CHARACTER-RANDOM-STAGING-SECRET
REDIS_PASSWORD=REPLACE-WITH-STAGING-REDIS-PASSWORD
FALKORDB_PASSWORD=REPLACE-WITH-STAGING-FALKORDB-PASSWORD
QDRANT_API_KEY=REPLACE-WITH-STAGING-QDRANT-API-KEY
METRICS_TOKEN=REPLACE-WITH-STAGING-METRICS-TOKEN
SMTP_SETTINGS_ENCRYPTION_KEY=REPLACE-WITH-STAGING-SMTP-ENCRYPTION-KEY

# --- Staging topology ------------------------------------------------------ #
# Real staging hostnames. `CORS_ORIGINS` and `PUBLIC_BASE_URL` are rejected by
# the backend's startup validation when they name localhost or a dev origin.
PUBLIC_BASE_URL=https://staging.example.internal
PUBLIC_API_URL=https://staging.example.internal/api
CORS_ORIGINS=https://staging.example.internal
# Loopback only, and deliberately not 8080: reach it over an SSH tunnel. The
# gateway speaks plain HTTP while the backend sets secure cookies, so this port
# must never be the public entry point.
HTTP_PORT=127.0.0.1:18080
# The edge `post_deploy_verify.sh` must probe in staging mode. Staging has no
# public DNS by design, so it is exempt from the public-DNS rule production is
# held to - but it is not exempt from having an edge, and not from TLS:
# AUTH_COOKIE_SECURE=true means no session cookie survives plain HTTP, which is
# why R-A8Q had to stand up a TLS terminator before Gate 3 bullet 1 could be
# measured at all. Point this at that terminator, not at HTTP_PORT.
STAGING_EDGE_BASE_URL=https://127.0.0.1:18443
# Every hostname that is production. A staging verification pointed at one of
# these measures production and files the result as staging evidence, so
# scripts/lib/edge_target.sh refuses it. Comma-separated.
#
# The real hostnames are deliberately NOT written here: this template is tracked,
# and `test_staging_compose.py::test_the_staging_template_exists_and_carries_no_real_value`
# refuses a staging template that names the production host — because a template
# that ships one is a copy-paste away from pointing staging at production, which
# is the exact failure this variable exists to prevent. Replace it in the real
# `.env.staging`, never here.
#
# The rule cannot fire on a list that is not declared, so `edge_target.sh` refuses
# a value that is still this placeholder rather than treating it as a hostname
# that will never match. An inert control is worse than an absent one.
PRODUCTION_PUBLIC_HOSTS=REPLACE-WITH-PRODUCTION-HOSTNAMES

# --- Gate 3 browser E2E ---------------------------------------------------- #
# The Playwright staging suite is exported separately from the stack's own
# environment; these are read by the RUN, not by the containers. Under
# CONTRACLAIM_STAGING_E2E=1 a missing one is a failure, never a skip.
#   E2E_BASE_URL              the staging edge (same value as STAGING_EDGE_BASE_URL)
#   E2E_RUN_ID                identifies everything the run creates. Supply the
#                             previous value to clean up a run that died before
#                             its teardown; leave unset for a fresh run.
#   E2E_PRODUCTION_HOSTS      hosts the fixtures refuse to write to. Same real
#                             hostnames as PRODUCTION_PUBLIC_HOSTS above; declare
#                             it, because the refusal cannot fire on a list that
#                             is absent or still a placeholder.
#   E2E_STAGING_HOST          the ONE host a fixture run may address - an
#                             allowlist of one, because a denylist of production
#                             hostnames cannot cover www., a trailing dot or a
#                             bare IP address, and all three reach production.
#                             R-A8U measured all three passing the denylist.
#   E2E_STAGING_ORG_ID        the organisation every fixture write must name
#   E2E_STAGING_PROJECT_ID    the project disposable documents are uploaded into
#   E2E_STAGING_EMAIL/_PASSWORD        bullet 1 and bullet 3's owner
#   E2E_ORG_ADMIN_EMAIL/_PASSWORD      bullet 2's org-admin
#   E2E_OUTSIDER_EMAIL/_PASSWORD       bullet 3's out-of-scope user, in a
#                                      DIFFERENT scope - an outsider who shares
#                                      the owner's scope proves nothing
FALKORDB_GRAPH_NAME=contraclaim_staging
QDRANT_COLLECTION=stg_document_vectors

# --- External credentials: STAGING-ISSUED ONLY ----------------------------- #
# These are the two decisions no amount of hardware substitutes for. Both are
# start-required, so the stack does not boot without them, and Gate 2 bullet 2
# cannot be satisfied by a placeholder.
OPENAI_API_KEY=REPLACE-WITH-STAGING-ISSUED-OPENAI-KEY
AWS_ACCESS_KEY_ID=REPLACE-WITH-STAGING-IAM-ACCESS-KEY-ID
AWS_SECRET_ACCESS_KEY=REPLACE-WITH-STAGING-IAM-SECRET-ACCESS-KEY
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=REPLACE-WITH-STAGING-DOCUMENT-BUCKET
BACKUP_S3_BUCKET=REPLACE-WITH-STAGING-BACKUP-BUCKET
BACKUP_S3_PREFIX=contraclaim-stg/backups

# --- Mail: no Gate 2 bullet exercises it ----------------------------------- #
# Start-required, so a syntactically valid placeholder is enough. A real
# production mail credential here would let staging send mail as production.
SMTP_HOST=smtp.example.internal
SMTP_PORT=587
SMTP_USERNAME=staging-noreply@example.internal
SMTP_PASSWORD=REPLACE-WITH-STAGING-SMTP-PASSWORD
SMTP_FROM_EMAIL=staging-noreply@example.internal

# --- Sidecars that are not deployed ---------------------------------------- #
# LANGGRAPH_ENABLED defaults to false and the service is in no production
# compose file, but the token is still start-required, so a placeholder
# satisfies compose without enabling anything.
LANGGRAPH_ENABLED=false
LANGGRAPH_API_TOKEN=staging-placeholder-not-in-use

# --- Backups --------------------------------------------------------------- #
# Staging-only path. `scripts/backup.sh` and `scripts/restore.sh` write here,
# and the Gate-8 restore drill reads from it. Never the production path.
BACKUP_ROOT=/var/backups/contraclaim-stg
BACKUP_REQUIRED_IN_PRODUCTION=true

# ===========================================================================
# Gate-2 live-test variables — for the TEST RUNNER process, not for compose.
# ===========================================================================
#
# Export these in the shell that runs pytest. Do NOT put them in the container
# environment and do NOT source the repository's `.env`: the run must be built
# explicitly, or an inherited developer value decides what the gate measured.
#
#   CONTRACLAIM_STAGING_GATE=1
#   ENVIRONMENT=staging
#   RUN_EXTERNAL_INTEGRATION_TESTS=1
#   FALKOR_TEST_HOST=<staging host or container IP>
#   FALKOR_TEST_PORT=6379
#   QDRANT_TEST_URL=http://<staging host>:6333
#   QDRANT_URL=http://<staging host>:6333
#   QDRANT_API_KEY=<the staging key above>
#   REDIS_TEST_URL=redis://:<staging redis password>@<staging host>:6379/0
#   DATABASE_URL=<the staging URI above>
#   OPENAI_API_KEY=<the staging-issued key above>
#
# `CONTRACLAIM_STAGING_GATE=1` makes every one of those mandatory before a
# single test is collected, refuses any that names localhost or 127.0.0.1,
# refuses the checked-out `config/secrets/qdrant_api_key`, and converts a skip
# in a required live module into a failure.
